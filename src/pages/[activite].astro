---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { activites } from '../data/activites';

export function getStaticPaths() {
  return activites.map((a) => ({ params: { activite: a.slug }, props: { a } }));
}
const { a } = Astro.props;

const answered = a.faq.filter((f) => f.answered);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: a.name,
    serviceType: a.name,
    description: a.description,
    areaServed: { '@type': 'AdministrativeArea', name: 'Est-Var, Var, France' },
    provider: { '@type': 'Organization', name: site.name, telephone: site.phoneIntl, url: site.domain },
    url: `${site.domain}/${a.slug}/`,
  },
  ...(answered.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: answered.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.domain },
      { '@type': 'ListItem', position: 2, name: a.name, item: `${site.domain}/${a.slug}/` },
    ],
  },
];
---
<Base title={a.title} description={a.description} path={`/${a.slug}/`} schema={schema} image={a.image}>
  <section class="content">
    <div class="wrap">
      <p class="eyebrow">Activité · −10 % au comptoir</p>
      <h1>{a.h1}</h1>
      {a.image && (
        <figure class="activity-hero">
          <img src={a.image} alt={a.imageAlt} loading="eager" />
        </figure>
      )}
      <div class="prose" set:html={a.contentHtml}></div>

      <div class="faqpage" style="margin-top:2.6rem">
        <p class="faq-name">Questions fréquentes</p>
        {a.faq.map((f) => (
          <details>
            <summary><h2>{f.question}</h2></summary>
            <div class="answer"><p>{f.answer}</p></div>
          </details>
        ))}
      </div>

      <div class="content-cta">
        <a class="btn btn-y" href={site.mapsUrl} target="_blank" rel="noopener">Venir au comptoir</a>
        <a class="btn btn-o" href={`tel:${site.phoneIntl}`}>Appeler le {site.phone}</a>
      </div>
    </div>
  </section>
</Base>
