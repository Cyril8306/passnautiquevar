---
import { site } from '../data/site';
---
<div id="pnv-popup" class="popup-overlay" hidden>
  <div class="popup-card" role="dialog" aria-modal="true" aria-label="Offre bonus avant de partir">
    <button class="popup-close" data-popup-close aria-label="Fermer">×</button>
    <p class="popup-eyebrow">Avant de partir</p>
    <h2 class="popup-title">+5 % offerts<br /><span class="hl">soit −15 % au comptoir</span></h2>
    <p class="popup-text">
      En plus des <strong>−10 %</strong> déjà appliqués à tout le monde au comptoir, dites le mot
      <strong>« SOURIRE »</strong> en arrivant à la base de La Gaillarde : on vous offre 5 % de
      remise supplémentaire.
    </p>
    <div class="popup-cta">
      <a class="btn btn-y" href={site.mapsUrl} target="_blank" rel="noopener" data-popup-close>Venir au comptoir</a>
      <a class="btn btn-o" href={`tel:${site.phoneIntl}`} data-popup-close>Appeler</a>
    </div>
    <p class="popup-note">Offre à mentionner sur place, dans la limite des disponibilités.</p>
  </div>
</div>

<script>
  (function () {
    const KEY = 'pnv_popup_shown';
    const overlay = document.getElementById('pnv-popup');
    if (!overlay) return;
    if (sessionStorage.getItem(KEY)) return;

    let shown = false;
    function show() {
      if (shown || sessionStorage.getItem(KEY)) return;
      shown = true;
      sessionStorage.setItem(KEY, '1');
      overlay.hidden = false;
    }
    function hide() {
      overlay.hidden = true;
    }

    // Intention de sortie (desktop) — la souris quitte le haut de la fenêtre
    document.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget && e.clientY < 10) show();
    });
    // Filet mobile / lecture longue : après 30 s sur le site
    const t = setTimeout(show, 30000);

    overlay.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === overlay || target.closest('[data-popup-close]')) {
        hide();
        clearTimeout(t);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hide();
    });
  })();
</script>
